{
  "openapi": "3.0.0",
  "info": {
    "title": "Microservicio de Inserción de Mascotas",
    "description": "Microservicio en Node.js para registrar e insertar mascotas en la base de datos.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://microservicio-insertar-node.onrender.com",
      "description": "Servidor de Producción"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Verificar estado del microservicio",
        "responses": {
          "200": { "description": "Servicio activo" }
        }
      }
    },
    "/insertar": {
      "post": {
        "summary": "Insertar una nueva mascota",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": { "type": "string", "example": "Firulais" },
                  "especie": { "type": "string", "example": "Perro" },
                  "estado": { "type": "string", "example": "Perdido" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Mascota insertada correctamente" },
          "400": { "description": "Datos de mascota no válidos" }
        }
      }
    }
  }
}